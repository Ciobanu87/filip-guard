# PREPARED ONLY. Root-controlled, nonsecret paths. Never source a repository env
# file as a shell script. Systemd EnvironmentFile syntax; no credentials here.
FG_CUSTOMER_AUTH_DB=/srv/filip-guard/state/accounts.sqlite
FG_CUSTOMER_DATA_ROOT=/srv/filip-guard/state/sites
FG_MONITOR_DB=/srv/filip-guard/state/monitor.sqlite
FG_AI_LEDGER_DB=/srv/filip-guard/state/advisor.sqlite
FG_GUARD_TEST_UI=0
FG_CUSTOMER_REGISTRATION=0
FG_AI_AUTHORIZED=0
FG_EMAIL_AUTHORIZED=0
FG_ACCOUNT_RECOVERY_AUTHORIZED=0
FG_STATE_BACKUP_AUTHORIZED=0
FG_GUARD_S3_SECRET_SOURCE=file
FG_GUARD_KEY_DIRECTORY=/etc/filip-guard/secrets/keyring
FG_GUARD_S3_CREDENTIALS_FILE=/etc/filip-guard/secrets/s3.json
# FG_GUARD_KEY_ID: existing retained version; no replacement/generation.
# FG_DEPLOYMENT_ID: existing 32-hex identifier, never change during recovery.
# FG_GUARD_S3_ENDPOINT, FG_GUARD_S3_BUCKET, FG_GUARD_S3_REGION: existing B2 values.
# Do not enable AI, customer registration, email, repairs or backup by copying this.

# Production remains held; no policy or validation receipt is provisioned here.
FG_AUTOFIX_PRODUCTION_AUTHORIZED=0

# Private allowlisted systemd events; no customer content or credentials.
FG_OPERATOR_EVENTS=1
