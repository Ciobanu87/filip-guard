# Nonsecret paths only; shared by UI and worker. Do not use ephemeral storage.
FG_CUSTOMER_AUTH_DB=/srv/filip-guard/accounts.sqlite
FG_CUSTOMER_DATA_ROOT=/srv/filip-guard/sites
FG_MONITOR_DB=/srv/filip-guard/monitor.sqlite
# Disabled until account/domain/recipients are verified and sending authorized.
FG_EMAIL_AUTHORIZED=0
FG_SMTP_HOST=smtp-relay.brevo.com
FG_SMTP_DAILY_LIMIT=300
# FG_SMTP_SENDER must be the real, verified transactional sender, set on host.
